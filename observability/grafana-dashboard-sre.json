{
 "uid": "payment-api-sre",
 "title": "Payment API - SRE (RED + SLO + Error Budget)",
 "tags": [
  "sre",
  "slo",
  "tp2"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "SLO & Error Budget (Availability 99.5 % / Latency p95 <= 200 ms)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "gauge",
   "title": "Error Budget Remaining (periode du dashboard)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0
       },
       {
        "color": "yellow",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     },
     "min": -1,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - ((1 - (sum(increase(http_requests_total{app=\"payment-api\",status!~\"5..\"}[$__range])) / clamp_min(sum(increase(http_requests_total{app=\"payment-api\"}[$__range])),1))) / 0.005)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Availability SLI (periode)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 5,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.995
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(http_requests_total{app=\"payment-api\",status!~\"5..\"}[$__range])) / clamp_min(sum(increase(http_requests_total{app=\"payment-api\"}[$__range])),1)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
